{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "thoth.config",
  "type": "object",
  "definitions": {
    "connectorSchedule": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "interval_seconds": { "type": "number", "minimum": 60 },
        "interval_hours": { "type": "number", "minimum": 0.016666666666666666 },
        "run_on_startup": { "type": "boolean", "default": false },
        "options": { "type": "object" }
      },
      "additionalProperties": false,
      "not": { "required": ["interval_seconds", "interval_hours"] },
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": { "anyOf": [
        { "required": ["interval_seconds"] },
        { "required": ["interval_hours"] }
      ] }
    },
    "connectorBudget": {
      "type": "object",
      "properties": {
        "max_bytes_per_file": { "type": ["integer", "null"], "minimum": 1 },
        "max_bytes_per_run": { "type": ["integer", "null"], "minimum": 1 },
        "max_files_per_run": { "type": ["integer", "null"], "minimum": 1 },
        "max_input_tokens_per_run": { "type": ["integer", "null"], "minimum": 1 },
        "max_output_tokens_per_run": { "type": ["integer", "null"], "minimum": 1 },
        "max_transcript_chunks_per_run": { "type": ["integer", "null"], "minimum": 1 },
        "transcript_chunk_chars": { "type": "integer", "minimum": 1 },
        "estimated_output_tokens_per_artifact": { "type": "integer", "minimum": 0 },
        "input_cost_per_1k_tokens_usd": { "type": "number", "minimum": 0 },
        "output_cost_per_1k_tokens_usd": { "type": "number", "minimum": 0 },
        "max_estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "llm": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z0-9_-]+$": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "type": { "type": "string" },
                "api_key_env": { "type": "string" },
                "base_url": { "type": ["string", "null"] },
                "has_vision": { "type": "boolean" },
                "command": { "type": "string" },
                "pi_provider": { "type": "string" },
                "install_if_missing": { "type": "boolean" },
                "install_command": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "command_pin": {
                  "type": "object",
                  "properties": {
                    "command": { "type": "string" },
                    "configured_command": { "type": "string" },
                    "resolved_command": { "type": ["string", "null"] },
                    "pi_provider": { "type": ["string", "null"] },
                    "model": { "type": ["string", "null"] }
                  },
                  "additionalProperties": true
                },
                "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
                "extra_args": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "models": {
                  "type": "object",
                  "patternProperties": {
                    "^[a-zA-Z0-9_-]+$": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "prompt": { "type": "string" },
                        "max_tokens": { "type": "integer" },
                        "temperature": { "type": "number" },
                        "input_cost_per_1k_tokens_usd": { "type": "number", "minimum": 0 },
                        "output_cost_per_1k_tokens_usd": { "type": "number", "minimum": 0 },
                        "cost_per_1k_tokens_usd": { "type": "number", "minimum": 0 }
                      },
                      "required": ["id"],
                      "additionalProperties": false
                    }
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "tasks": {
          "type": "object",
          "properties": {
            "transcript": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "retry_interval_hours": { "type": "number", "minimum": 0 },
                "fallback": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": { "type": "string" },
                      "model": { "type": "string" }
                    },
                    "required": ["provider"],
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            },
            "translation": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "fallback": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": { "type": "string" },
                      "model": { "type": "string" }
                    },
                    "required": ["provider"],
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            },
            "archivist": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "fallback": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": { "type": "string" },
                      "model": { "type": "string" }
                    },
                    "required": ["provider"],
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            },
            "embedding": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "fallback": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": { "type": "string" },
                      "model": { "type": "string" }
                    },
                    "required": ["provider"],
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "prompts": {
          "type": "object",
          "properties": {
            "translation": {
              "type": "object",
              "properties": {
                "system": { "type": "string" }
              },
              "additionalProperties": true
            },
            "archivist": {
              "type": "object",
              "properties": {
                "system_file": { "type": "string" },
                "user_file": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": true
    },
    "processing": {
      "type": "object",
      "additionalProperties": true
    },
    "downloads": {
      "type": "object",
      "additionalProperties": true
    },
    "database": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "capture_event_store": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "backend": { "type": "string", "enum": ["postgres"] },
            "dsn_env": { "type": "string" },
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "connect_timeout_seconds": { "type": "integer", "minimum": 1 },
            "application_name": { "type": "string", "minLength": 1 },
            "migration_lock_id": { "type": "integer" }
          },
          "additionalProperties": false
        },
        "ccf_archive": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "dual_write": { "type": "boolean" },
            "mirror_transcripts": {
              "type": "boolean",
              "description": "Dual-write family flag: mirror transcript captures as experience.utterance records. Requires dual_write."
            },
            "mirror_semantic": {
              "type": "boolean",
              "description": "Dual-write family flag: mirror canonical entities resolved at capture time as semantic.entity records. Requires dual_write."
            },
            "mirror_review": {
              "type": "boolean",
              "description": "Dual-write family flag: mirror artifact/semantic-memory review decisions as governance.review_decision records (materializing candidate semantic.assertion targets). Requires dual_write."
            },
            "mirror_wiki": {
              "type": "boolean",
              "description": "Dual-write family flag: mirror compiled semantic wiki pages as experience.artifact wiki projections with mandatory evidence links. Requires dual_write."
            },
            "backend": { "type": "string", "enum": ["postgres"] },
            "dsn_env": { "type": "string" },
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "connect_timeout_seconds": { "type": "integer", "minimum": 1 },
            "application_name": { "type": "string", "minLength": 1 },
            "migration_lock_id": { "type": "integer" },
            "device_key_path": { "type": "string", "minLength": 1 },
            "archive_key_path": { "type": "string", "minLength": 1 },
            "package_root": { "type": "string", "minLength": 1 },
            "error_log_path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "connectors": {
      "type": "object",
      "properties": {
        "plugin_dirs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skill_dirs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowlist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pins": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "source_name": { "type": "string" },
              "entrypoint": { "type": "string" },
              "cli_command": { "type": ["string", "null"] },
              "origin": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "budgets": {
          "type": "object",
          "properties": {
            "defaults": { "$ref": "#/definitions/connectorBudget" },
