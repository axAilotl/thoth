{
  "paths": {
    "vault_dir": "/data/account/vault",
    "wiki_dir": "/data/account/wiki",
    "system_dir": "/data/account/system",
    "cache_dir": "cache"
  },
  "database": {"path": "meta.db", "capture_event_store": {"enabled": false}},
  "processing": {"enable_llm_features": false},
  "managed_wiki": {
    "enabled": false,
    "callback_socket": "/run/cissa-thoth/cissa-model.sock",
    "callback_timeout_seconds": 180,
    "max_callback_response_bytes": 2097152,
    "max_sources": 100,
    "max_topics": 10,
    "max_page_bytes": 1048576
  },
  "collection": {
    "max_history_export_bytes": 1048576,
    "max_x_archive_file_bytes": 8388608,
    "max_x_archive_documents": 2000,
    "max_history_messages": 1000,
    "max_history_message_characters": 100000,
    "max_items": 100,
    "max_pages": 10,
    "request_timeout_seconds": 30,
    "worker_timeout_seconds": 90,
    "max_response_bytes": 2097152,
    "max_attempts": 5,
    "retry_base_seconds": 300,
    "retry_max_seconds": 3600
  }
}
