{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.1:sync.producer-batch",
  "title": "CCF Signed Producer Batch",
  "type": "object",
  "properties": {
    "format": {
      "const": "ccf.producer-batch/0.1.1"
    },
    "batch_id": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/batchUrn"
    },
    "producer_id": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/recordUrn"
    },
    "producer_sequence": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/uint64"
    },
    "previous_batch_hash": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "credential_id": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/credentialUrn"
    },
    "created_at": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/timestamp"
    },
    "semantic_catalog_root": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/digest"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "urn:ccf:schema:0.1.1:submissions.record"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "urn:ccf:schema:0.1.1:submissions.link"
      }
    },
    "blobs": {
      "type": "array",
      "items": {
        "$ref": "urn:ccf:schema:0.1.1:submissions.blob"
      }
    },
    "blob_transfers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blob_id": {
            "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/blobUrn"
          },
          "transfer_ref": {
            "type": "string"
          },
          "offset": {
            "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/uint64"
          },
          "length": {
            "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/uint64"
          },
          "complete": {
            "type": "boolean"
          }
        },
        "required": [
          "blob_id",
          "transfer_ref",
          "offset",
          "length",
          "complete"
        ],
        "additionalProperties": false
      }
    },
    "batch_hash": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/digest"
    },
    "signature_profile": {
      "const": "ed25519-jcs-v1"
    },
    "signature": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/base64url"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "format",
    "batch_id",
    "producer_id",
    "producer_sequence",
    "previous_batch_hash",
    "credential_id",
    "created_at",
    "semantic_catalog_root",
    "records",
    "links",
    "blobs",
    "blob_transfers",
    "batch_hash",
    "signature_profile",
    "signature",
    "extensions"
  ],
  "additionalProperties": false
}
