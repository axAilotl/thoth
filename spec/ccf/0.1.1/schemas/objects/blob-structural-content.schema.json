{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.1:objects.blob-structural-content",
  "title": "CCF Blob Structural Content",
  "type": "object",
  "properties": {
    "type": {
      "const": "blob.manifest"
    },
    "type_version": {
      "const": 1
    },
    "type_visibility": {
      "enum": [
        "clear",
        "sealed"
      ]
    },
    "schema_digest": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/digest"
    },
    "registry_entry_digest": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/digest"
    },
    "retention_profile": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/retentionProfile"
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "byte_length": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/uint64"
    },
    "content_commitment": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/digest"
    },
    "content_profile": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/profileName"
    },
    "availability_class": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/availabilityClass"
    },
    "erasure_domain_id": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/lineageUrn"
        },
        {
          "type": "null"
        }
      ]
    },
    "structural_payload": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "type",
    "type_version",
    "type_visibility",
    "schema_digest",
    "registry_entry_digest",
    "retention_profile",
    "media_type",
    "byte_length",
    "content_commitment",
    "content_profile",
    "availability_class",
    "erasure_domain_id",
    "structural_payload",
    "extensions"
  ],
  "additionalProperties": false
}
