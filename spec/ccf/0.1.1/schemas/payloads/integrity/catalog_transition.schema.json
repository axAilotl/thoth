{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.1:payload.integrity.catalog_transition",
  "title": "Semantic Catalog Transition Payload",
  "type": "object",
  "properties": {
    "previous_catalog_root": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/digest"
    },
    "new_catalog_root": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/digest"
    },
    "activation_sequence": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/uint64"
    },
    "catalog_blob_id": {
      "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/blobUrn"
    },
    "reason": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "previous_catalog_root",
    "new_catalog_root",
    "activation_sequence",
    "catalog_blob_id",
    "reason",
    "extensions"
  ],
  "additionalProperties": false
}
