{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.1:registries.type-registry",
  "title": "CCF Type Registry",
  "type": "object",
  "properties": {
    "registry": {
      "const": "ccf.types/0.1.1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/typeName"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "semantic_schema_id": {
            "type": "string",
            "format": "uri"
          },
          "structural_schema_id": {
            "oneOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "active",
              "deprecated",
              "experimental"
            ]
          },
          "description": {
            "type": "string"
          },
          "object_kind": {
            "const": "record"
          },
          "profile": {
            "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/profileName"
          },
          "retention_profile": {
            "$ref": "urn:ccf:schema:0.1.1:common.defs#/$defs/retentionProfile"
          },
          "default_type_visibility": {
            "enum": [
              "clear",
              "sealed"
            ]
          },
          "lineage_mode": {
            "enum": [
              "none",
              "compare_and_swap"
            ]
          },
          "terminal_transitions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "required_authority": {
            "type": "string"
          },
          "state_machine_id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "version",
          "semantic_schema_id",
          "structural_schema_id",
          "status",
          "description",
          "object_kind",
          "profile",
          "retention_profile",
          "default_type_visibility",
          "lineage_mode",
          "terminal_transitions",
          "required_authority",
          "state_machine_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "registry",
    "entries"
  ],
  "additionalProperties": false
}
