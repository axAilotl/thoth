{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.2.0:registries.level-registry",
  "title": "CCF Guarantee Level Registry",
  "type": "object",
  "properties": {
    "registry": {"const": "ccf.levels/0.2.0"},
    "entries": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "urn:ccf:schema:0.2.0:common.defs#/$defs/levelId"},
          "rank": {"type": "integer", "minimum": 1, "maximum": 4},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "depends_on": {
            "oneOf": [
              {"$ref": "urn:ccf:schema:0.2.0:common.defs#/$defs/levelId"},
              {"type": "null"}
            ]
          },
          "accepts_levels": {
            "type": "array",
            "items": {"$ref": "urn:ccf:schema:0.2.0:common.defs#/$defs/levelId"},
            "uniqueItems": true
          },
          "required_machinery": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          },
          "claim": {"type": "string", "minLength": 1},
          "exclusions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "required_suites": {
            "type": "array",
            "items": {"type": "string", "pattern": "^check-[a-z0-9-]+$"},
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id", "rank", "title", "description", "depends_on", "accepts_levels",
          "required_machinery", "claim", "exclusions", "required_suites"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["registry", "entries"],
  "additionalProperties": false
}
