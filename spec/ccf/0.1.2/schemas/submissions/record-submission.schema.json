{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2:submissions.record",
  "title": "CCF Record Submission",
  "type": "object",
  "properties": {
    "submission_kind": {
      "const": "record"
    },
    "id": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/recordUrn"
    },
    "type": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/typeName"
    },
    "type_version": {
      "type": "integer",
      "minimum": 1
    },
    "type_visibility": {
      "enum": [
        "clear",
        "sealed"
      ]
    },
    "retention_profile_hint": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/retentionProfile"
    },
    "recorded_by": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/recordUrn"
    },
    "recorded_at": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/timestamp"
    },
    "occurred_at": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/occurredAt"
    },
    "origin": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/originClaim"
    },
    "claims": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/claimedRecordContext"
    },
    "lineage": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/lineageTransition"
    },
    "payload": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "submission_kind",
    "id",
    "type",
    "type_version",
    "type_visibility",
    "retention_profile_hint",
    "recorded_by",
    "recorded_at",
    "claims",
    "payload",
    "extensions"
  ],
  "additionalProperties": false
}
