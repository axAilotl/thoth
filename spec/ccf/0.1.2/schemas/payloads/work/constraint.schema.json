{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2:payload.work.constraint",
  "title": "work.constraint payload",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "preference",
        "soft",
        "hard"
      ]
    },
    "scope": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "description",
    "severity",
    "scope",
    "extensions"
  ],
  "additionalProperties": false
}
