{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2:payload.experience.utterance",
  "title": "experience.utterance payload",
  "type": "object",
  "properties": {
    "text": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "speaker_id": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/recordUrn"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/uint64"
        },
        {
          "type": "null"
        }
      ]
    },
    "transcription": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string"
            },
            "engine_version": {
              "type": "string"
            },
            "mean_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "language_detected": {
              "type": "string"
            }
          },
          "required": [
            "engine",
            "engine_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "text",
    "language",
    "extensions"
  ],
  "additionalProperties": false
}
