{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2:registries.suppression-profile-registry",
  "title": "CCF Suppression Profile Registry",
  "type": "object",
  "properties": {
    "registry": { "const": "ccf.suppression-profiles/0.1.2" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "const": "ccf-hmac-sha256-suppression-v1" },
          "origin_token_derivation": { "const": "HMAC-SHA-256(key, UTF8('ccf:suppression-token:v1\\0') || UTF8(JCS(origin_preimage)))" },
          "content_token_derivation": { "const": "content_digest = SHA-256(UTF8(JCS(canonical plaintext semantic payload))) for record-semantic/link-semantic or SHA-256(canonical plaintext Blob bytes) for blob-content; HMAC-SHA-256(key, UTF8('ccf:suppression-content:v1\\0') || UTF8(content_class) || 0x00 || raw(content_digest))" },
          "scope_commitment_derivation": { "const": "SHA-256(UTF8('ccf:suppression-scope:v1\\0') || UTF8(JCS(scope_object_ids sorted in ascending Unicode code-point order; duplicates preserved)))" },
          "preimage_schema_id": { "const": "urn:ccf:schema:0.1.2:security.suppression-preimage" },
          "token_encoding": { "const": "hmac-sha256:<64 lowercase hex characters>" },
          "entry_order": { "const": "ascending Unicode code-point order of complete token strings" },
          "duplicates": { "const": "reject" },
          "leaf_hash": { "const": "SHA-256(UTF8('ccf:suppression-leaf:v1\\0') || UTF8(token))" },
          "node_hash": { "const": "SHA-256(UTF8('ccf:suppression-node:v1\\0') || left || right)" },
          "empty_root": { "const": "SHA-256(UTF8('ccf:suppression-empty:v1\\0'))" },
          "tree_shape": { "const": "recursive split at largest power of two smaller than the node count" },
          "minimum_key_bytes": { "const": 32 }
        },
        "required": ["name", "origin_token_derivation", "content_token_derivation", "scope_commitment_derivation", "preimage_schema_id", "token_encoding", "entry_order", "duplicates", "leaf_hash", "node_hash", "empty_root", "tree_shape", "minimum_key_bytes"],
        "additionalProperties": false
      }
    }
  },
  "required": ["registry", "entries"],
  "additionalProperties": false
}
