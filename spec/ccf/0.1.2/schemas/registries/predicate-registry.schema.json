{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2:registries.predicate-registry",
  "title": "CCF Predicate Registry",
  "type": "object",
  "properties": {
    "registry": {
      "const": "ccf.predicates/0.1.2"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/predicateName"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "domain": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "range": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inverse": {
            "oneOf": [
              {
                "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/predicateName"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "active",
              "deprecated",
              "experimental"
            ]
          }
        },
        "required": [
          "name",
          "version",
          "description",
          "domain",
          "range",
          "inverse",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "registry",
    "entries"
  ],
  "additionalProperties": false
}
