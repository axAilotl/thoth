{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2:operational.erasure-operation",
  "title": "CCF Erasure Operation State",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string"
    },
    "decision_id": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/recordUrn"
    },
    "stage": {
      "enum": [
        "request",
        "decision",
        "block",
        "destroy",
        "verify",
        "receipt",
        "failed"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/objectUrn"
      }
    },
    "profile": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/profileName"
    },
    "started_at": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/timestamp"
    },
    "last_error": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "operation_id",
    "decision_id",
    "stage",
    "targets",
    "profile",
    "started_at",
    "updated_at",
    "last_error"
  ],
  "additionalProperties": false
}
