{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2:payload.governance.legal_basis",
  "title": "governance.legal_basis payload",
  "type": "object",
  "properties": {
    "subject_id": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/recordUrn"
    },
    "controller_id": {
      "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/recordUrn"
    },
    "basis_code": {
      "type": "string"
    },
    "purposes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "data_classes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "jurisdiction": {
      "type": "object",
