{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2:payload.semantic.entity_resolution",
  "title": "semantic.entity_resolution payload",
  "type": "object",
  "properties": {
    "action": {
      "enum": [
        "same_as",
        "distinct_from",
        "coalesce",
        "split",
        "rename",
        "unresolved"
      ]
    },
    "entity_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/recordUrn"
      },
      "uniqueItems": true
    },
    "canonical_entity_id": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/recordUrn"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:ccf:schema:0.1.2:common.defs#/$defs/objectUrn"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "action",
    "entity_ids",
    "reason",
    "evidence_refs",
    "extensions"
  ],
  "additionalProperties": false
}
