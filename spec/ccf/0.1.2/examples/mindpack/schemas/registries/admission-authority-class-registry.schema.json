{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2:registries.admission-authority-class-registry",
  "title": "CCF Admission Authority Class Registry",
  "type": "object",
  "properties": {
    "registry": {
      "const": "ccf.admission-authority-classes/0.1.2"
    },
    "evaluator_profile": {
      "const": "ccf-admission-authority-v1"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "class": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "evaluation_mode": {
            "enum": [
              "structural_state_machine",
              "archive_admission_only",
              "any_pinned_basis",
              "basis_allowlist",
              "person_or_acceptance",
              "person_acceptance",
              "archive_or_basis"
            ]
          },
          "acceptable_actor_kinds": {
            "type": "array",
            "items": { "enum": ["archive_admission", "authenticated_producer"] },
            "uniqueItems": true
          },
          "claim_required": { "type": "boolean" },
          "acceptable_authority_bases": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "archive_admission_basis_override": {
            "const": "any_pinned_basis"
          },
          "required_relationship": {
            "enum": [
              "lineage_state_machine_passed",
              "archive_signed_admission",
              "pinned_basis",
              "accepted_by_or_person_basis",
              "accepted_by_or_person_accepted_basis",
              "archive_admission_or_explicit_authorization"
            ]
          },
          "person_acceptance": {
            "enum": ["not_consulted", "accepted_by_may_satisfy", "required"]
          },
          "canonical_state_consulted": {
            "type": "array",
            "items": {
              "enum": [
                "authority_basis_registry",
                "producer_device_credential",
                "archive_signer_state",
                "lineage_state_machine"
              ]
            },
            "uniqueItems": true
          },
          "failure_reason": { "type": "string", "minLength": 1 },
          "pinned_evaluator": {
            "oneOf": [
              { "const": "ccf-admission-authority-v1" },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "class",
          "evaluation_mode",
          "acceptable_actor_kinds",
          "claim_required",
          "acceptable_authority_bases",
          "required_relationship",
          "person_acceptance",
          "canonical_state_consulted",
          "failure_reason",
          "pinned_evaluator"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["registry", "evaluator_profile", "entries"],
  "additionalProperties": false
}
