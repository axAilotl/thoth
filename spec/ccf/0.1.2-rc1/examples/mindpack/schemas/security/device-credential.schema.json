{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2-rc1:payload.core.device_credential",
  "title": "CCF Device Credential Payload",
  "type": "object",
  "properties": {
    "credential_id": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/credentialUrn"
    },
    "subject_id": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/recordUrn"
    },
    "issuer_key_id": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/keyUrn"
    },
    "signing_key": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "ed25519"
        },
        "public_key": {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/base64url"
        },
        "key_id": {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/keyUrn"
        }
      },
      "required": [
        "profile",
        "public_key",
        "key_id"
      ],
      "additionalProperties": false
    },
    "encryption_key": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "profile": {
              "enum": [
                "x25519",
                "p256"
              ]
            },
            "public_key": {
              "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/base64url"
            },
            "key_id": {
              "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/keyUrn"
            }
          },
          "required": [
            "profile",
            "public_key",
            "key_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "valid_from": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/timestamp"
    },
    "expires_at": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "offline_grace_until": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "credential_id",
    "subject_id",
    "issuer_key_id",
    "signing_key",
    "encryption_key",
    "scopes",
    "valid_from",
    "expires_at",
    "offline_grace_until",
    "extensions"
  ],
  "additionalProperties": false
}
