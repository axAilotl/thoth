{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2-rc1:payload.core.source",
  "title": "core.source payload",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "connector": {
      "type": "string"
    },
    "native_identity": {
      "type": "string"
    },
    "trust_class": {
      "enum": [
        "trusted",
        "authenticated",
        "untrusted",
        "hostile",
        "unknown"
      ]
    },
    "producer_key_id": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/keyUrn"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "kind",
    "name",
    "connector",
    "native_identity",
    "trust_class",
    "extensions"
  ],
  "additionalProperties": false
}
