{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2-rc1:registries.link-registry",
  "title": "CCF Link Registry",
  "type": "object",
  "properties": {
    "registry": {
      "const": "ccf.links/0.1.2-rc1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/typeName"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "deprecated",
              "experimental"
            ]
          },
          "profile": {
            "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/profileName"
          },
          "retention_profile": {
            "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/retentionProfile"
          },
          "default_type_visibility": {
            "enum": [
              "clear",
              "sealed"
            ]
          },
          "endpoints_location": {
            "enum": [
              "structural",
              "semantic"
            ]
          },
          "selector_location": {
            "enum": [
              "none",
              "semantic"
            ]
          },
          "transitive": {
            "type": "boolean"
          },
          "acyclic": {
            "type": "boolean"
          },
          "policy_propagates": {
            "type": "boolean"
          },
          "inverse": {
            "oneOf": [
              {
                "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/typeName"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "version",
          "description",
          "status",
          "profile",
          "retention_profile",
          "default_type_visibility",
          "endpoints_location",
          "selector_location",
          "transitive",
          "acyclic",
          "policy_propagates",
          "inverse"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "registry",
    "entries"
  ],
  "additionalProperties": false
}
