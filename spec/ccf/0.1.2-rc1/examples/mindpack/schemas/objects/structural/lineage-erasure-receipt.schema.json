{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2-rc1:structural.lineage.erasure_receipt",
  "title": "Erasure Receipt Structural Payload",
  "type": "object",
  "properties": {
    "decision_id": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/recordUrn"
    },
    "profile": {
      "enum": [
        "logical",
        "storage_verified",
        "cryptographic"
      ]
    },
    "verified_at": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/timestamp"
    },
    "target_count": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/uint64"
    },
    "destroyed_key_count": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/uint64"
    },
    "status": {
      "enum": [
        "verified",
        "partial",
        "failed"
      ]
    },
    "membership_link_type": {
      "const": "ccf.covers"
    },
    "suppression_commitment": {
          "type": "object",
          "properties": {
            "profile": { "const": "ccf-hmac-sha256-suppression-v1" },
            "suppression_set_record_id": {
              "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/recordUrn"
            },
            "suppression_blob_id": {
              "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/blobUrn"
            },
            "entry_count": {
              "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/uint64"
            },
            "entries_merkle_root": {
              "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/digest"
            },
            "key_profile_id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "scope_commitment": {
              "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/digest"
            }
          },
          "required": [
            "profile",
            "suppression_set_record_id",
            "suppression_blob_id",
            "entry_count",
            "entries_merkle_root",
            "key_profile_id",
            "scope_commitment"
          ],
          "additionalProperties": false
    }
  },
  "required": [
    "decision_id",
    "profile",
    "verified_at",
    "target_count",
    "destroyed_key_count",
    "status",
    "membership_link_type",
    "suppression_commitment"
  ],
  "additionalProperties": false
}
