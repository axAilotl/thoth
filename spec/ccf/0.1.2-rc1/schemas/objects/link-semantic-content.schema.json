{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2-rc1:objects.link-semantic-content",
  "title": "CCF Link Semantic Content",
  "type": "object",
  "properties": {
    "sealed_type": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/typeName"
        },
        "type_version": {
          "type": "integer",
          "minimum": 1
        },
        "schema_digest": {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/digest"
        }
      },
      "required": [
        "type",
        "type_version",
        "schema_digest"
      ],
      "additionalProperties": false
    },
    "endpoints": {
      "type": "object",
      "properties": {
        "from_id": {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/objectUrn"
        },
        "to_id": {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/objectUrn"
        }
      },
      "required": [
        "from_id",
        "to_id"
      ],
      "additionalProperties": false
    },
    "recorded_by": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/recordUrn"
    },
    "recorded_at": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/timestamp"
    },
    "claimed": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/claimedRecordContext"
    },
    "privacy": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/privacy"
    },
    "policy_ref": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/policyRef"
    },
    "authority": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/authority"
    },
    "epistemic": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/epistemic"
    },
    "producer_evidence": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/producerEvidence"
    },
    "selector": {
      "type": "object"
    },
    "payload": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "recorded_by",
    "recorded_at",
    "payload",
    "extensions"
  ],
  "additionalProperties": false
}
