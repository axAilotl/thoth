{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2-rc1:structural.lineage.link_disposition",
  "title": "Link Disposition Structural Payload",
  "type": "object",
  "properties": {
    "target_link_id": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/linkUrn"
    },
    "action": {
      "enum": [
        "retract",
        "supersede",
        "invalidate_selector",
        "tombstone",
        "restore"
      ]
    },
    "previous_disposition_id": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/recordUrn"
        },
        {
          "type": "null"
        }
      ]
    },
    "replacement_link_id": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/linkUrn"
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal": {
      "type": "boolean"
    }
  },
  "required": [
    "target_link_id",
    "action",
    "previous_disposition_id",
    "replacement_link_id",
    "terminal"
  ],
  "additionalProperties": false
}
