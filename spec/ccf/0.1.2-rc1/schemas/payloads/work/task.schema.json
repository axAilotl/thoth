{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2-rc1:payload.work.task",
  "title": "work.task payload",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "ready",
        "in_progress",
        "blocked",
        "done",
        "cancelled"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "owner_id": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/recordUrn"
        },
        {
          "type": "null"
        }
      ]
    },
    "due_at": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "title",
    "description",
    "status",
    "priority",
    "extensions"
  ],
  "additionalProperties": false
}
