{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2-rc1:payload.security.finding",
  "title": "security.finding payload",
  "type": "object",
  "properties": {
    "finding_kind": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "disposition": {
      "enum": [
        "observe",
        "quarantine",
        "block",
        "release",
        "false_positive"
      ]
    },
    "scanner": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/objectUrn"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "finding_kind",
    "severity",
    "disposition",
    "scanner",
    "summary",
    "evidence_refs",
    "extensions"
  ],
  "additionalProperties": false
}
