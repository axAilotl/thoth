{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2-rc1:payload.integrity.commit",
  "title": "integrity.commit payload",
  "type": "object",
  "properties": {
    "archive_id": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/archiveUrn"
    },
    "sequence": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/uint64"
    },
    "parent_commit_hash": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "batch_merkle_root": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/digest"
    },
    "member_count": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/uint64"
    },
    "hash_profile": {
      "const": "ccf-jcs-sha256-v1"
    },
    "signature_profile": {
      "const": "ed25519"
    },
    "signer_key_id": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/keyUrn"
    },
    "committed_at": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/timestamp"
    },
    "signature": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/base64url"
    },
    "extensions": {
      "type": "object"
    },
    "signer_public_key": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/base64url"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "archive_id",
    "sequence",
    "parent_commit_hash",
    "batch_merkle_root",
    "member_count",
    "hash_profile",
    "signature_profile",
    "signer_key_id",
    "committed_at",
    "signature",
    "extensions",
    "signer_public_key"
  ],
  "additionalProperties": false
}
