{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2-rc1:security.suppression-preimage",
  "title": "CCF Suppression Token Preimage",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "format": { "const": "ccf.suppression-preimage/1" },
        "kind": { "const": "origin" },
        "source_id": { "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/recordUrn" },
        "native_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "object_kind": { "enum": ["record", "link", "blob"] }
      },
      "required": ["format", "kind", "source_id", "native_id", "revision", "object_kind"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "format": { "const": "ccf.suppression-preimage/1" },
        "kind": { "const": "content" },
        "content_commitment": { "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/digest" }
      },
      "required": ["format", "kind", "content_commitment"],
      "additionalProperties": false
    }
  ]
}
