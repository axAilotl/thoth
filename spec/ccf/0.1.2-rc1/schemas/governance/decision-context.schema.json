{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccf:schema:0.1.2-rc1:governance.decision-context",
  "title": "CCF Decision Context",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "requester": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/recordUrn"
    },
    "recipient": {
      "oneOf": [
        {
          "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/recordUrn"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/recordUrn"
    },
    "destination": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "object"
    },
    "requested_at": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/timestamp"
    },
    "object_ids": {
      "type": "array",
      "items": {
        "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/objectUrn"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "head_sequence": {
      "$ref": "urn:ccf:schema:0.1.2-rc1:common.defs#/$defs/uint64"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "operation",
    "purpose",
    "requester",
    "runtime",
    "destination",
    "jurisdiction",
    "requested_at",
    "object_ids",
    "head_sequence",
    "extensions"
  ],
  "additionalProperties": false
}
